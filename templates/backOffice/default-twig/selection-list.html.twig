{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block body_testid %}selection-list{% endblock %}

{% block title %}{{ 'Selections'|trans({}, 'selection.bo.default') }}{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans({}, 'selection.bo.default') }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.tools.index') }}">{{ 'Tools'|trans({}, 'selection.bo.default') }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Selection'|trans({}, 'selection.bo.default') }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {# ------------------------ Containers ------------------------ #}
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="card-title mb-0">{{ 'Selections Containers'|trans({}, 'selection.bo.default') }}</span>
            {% if is_granted('CREATE', {resource: 'admin.selection', module: 'Selection'}) %}
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#selection_container_creation_dialog"
                        title="{{ 'Add a new selection Container'|trans({}, 'selection.bo.default') }}">
                    <i class="bi bi-plus-lg"></i>
                </button>
            {% endif %}
        </div>
        <div class="card-body table-responsive">
            <table class="table table-striped" id="selection-list-containers-table">
                <thead>
                <tr>
                    <th class="text-center">{{ 'ID'|trans({}, 'selection.bo.default') }}</th>
                    <th>{{ 'Code'|trans({}, 'selection.bo.default') }}</th>
                    <th>{{ 'Title'|trans({}, 'selection.bo.default') }}</th>
                    <th>{{ 'Position'|trans({}, 'selection.bo.default') }}</th>
                    <th class="text-center">{{ 'Online'|trans({}, 'selection.bo.default') }}</th>
                    <th class="actions text-center">{{ 'Actions'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for container in containers %}
                    <tr data-row-id="{{ container.id }}">
                        <td class="text-center">{{ container.id }}</td>
                        <td>
                            <a href="{{ path('admin.selection.container.view', {'selectionContainerId': container.id}) }}">{{ container.code }}</a>
                        </td>
                        <td>
                            <a href="{{ path('admin.selection.container.view', {'selectionContainerId': container.id}) }}">{{ container.title }}</a>
                        </td>
                        <td>
                            <a href="{{ path('admin.selection.container.update-position', {'selection_container_id': container.id, 'position': container.position}) }}"
                               class="badge text-bg-secondary text-decoration-none">{{ container.position }}</a>
                        </td>
                        <td class="text-center">
                            {% if container.visible %}
                                <i class="bi bi-check-circle-fill text-success"></i>
                            {% else %}
                                <i class="bi bi-x-circle-fill text-danger"></i>
                            {% endif %}
                        </td>
                        <td class="actions text-center">
                            <a class="btn btn-secondary btn-sm" href="{{ path('admin.selection.container.update', {'selectionContainerId': container.id}) }}"
                               title="{{ 'Change this selection'|trans }}"><i class="bi bi-pencil"></i></a>
                            {% if is_granted('DELETE', {resource: 'admin.selection', module: 'Selection'}) %}
                                <button type="button" class="btn btn-secondary btn-sm selection-container-delete" data-id="{{ container.id }}"
                                        data-bs-toggle="modal" data-bs-target="#selection_container_delete_dialog"
                                        title="{{ 'Delete this selection'|trans }}"><i class="bi bi-trash"></i></button>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center text-muted">{{ 'No container'|trans({}, 'selection.bo.default') }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# ------------------------ Selections without container ------------------------ #}
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="card-title mb-0">{{ 'Selections without container'|trans({}, 'selection.bo.default') }}</span>
            {% if is_granted('CREATE', {resource: 'admin.selection', module: 'Selection'}) %}
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#selection_creation_dialog"
                        title="{{ 'Add a new Selection'|trans({}, 'selection.bo.default') }}">
                    <i class="bi bi-plus-lg"></i>
                </button>
            {% endif %}
        </div>
        <div class="card-body table-responsive">
            <table class="table table-striped" id="selection-list-selections-table">
                <thead>
                <tr>
                    <th class="text-center">{{ 'ID'|trans({}, 'selection.bo.default') }}</th>
                    <th>{{ 'Code'|trans({}, 'selection.bo.default') }}</th>
                    <th>{{ 'Title'|trans({}, 'selection.bo.default') }}</th>
                    <th>{{ 'Position'|trans({}, 'selection.bo.default') }}</th>
                    <th class="text-center">{{ 'Online'|trans({}, 'selection.bo.default') }}</th>
                    <th class="actions text-center">{{ 'Actions'|trans({}, 'selection.bo.default') }}</th>
                </tr>
                </thead>
                <tbody>
                {% for selection in selections %}
                    <tr data-row-id="{{ selection.id }}">
                        <td class="text-center">{{ selection.id }}</td>
                        <td>
                            <a href="{{ path('selection.update', {'selectionId': selection.id}) }}">{{ selection.code }}</a>
                        </td>
                        <td>
                            <a href="{{ path('selection.update', {'selectionId': selection.id}) }}">{{ selection.title }}</a>
                        </td>
                        <td>
                            <a href="{{ path('admin.selection.update-position', {'selection_id': selection.id, 'position': selection.position}) }}"
                               class="badge text-bg-secondary text-decoration-none">{{ selection.position }}</a>
                        </td>
                        <td class="text-center">
                            {% if selection.visible %}
                                <i class="bi bi-check-circle-fill text-success"></i>
                            {% else %}
                                <i class="bi bi-x-circle-fill text-danger"></i>
                            {% endif %}
                        </td>
                        <td class="actions text-center">
                            <a class="btn btn-secondary btn-sm" href="{{ path('selection.update', {'selectionId': selection.id}) }}"
                               title="{{ 'Change this selection'|trans({}, 'selection.bo.default') }}"><i class="bi bi-pencil"></i></a>
                            {% if is_granted('DELETE', {resource: 'admin.selection', module: 'Selection'}) %}
                                <button type="button" class="btn btn-secondary btn-sm selection-delete" data-id="{{ selection.id }}"
                                        data-bs-toggle="modal" data-bs-target="#selection_delete_dialog"
                                        title="{{ 'Delete this selection'|trans({}, 'selection.bo.default') }}"><i class="bi bi-trash"></i></button>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center text-muted">{{ 'No selection'|trans({}, 'selection.bo.default') }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# ------------------------ Create container dialog ------------------------ #}
    <div class="modal fade" id="selection_container_creation_dialog" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" action="{{ path('selection.create.selection.container') }}">
                <input type="hidden" name="{{ container_create_form.vars.full_name }}[success_url]" value="{{ path('selection.list') }}">
                <input type="hidden" name="{{ container_create_form.vars.full_name }}[locale]" value="{{ edit_locale }}">
                <input type="hidden" name="{{ container_create_form.vars.full_name }}[_token]" value="{{ container_create_form._token.vars.value }}">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ 'Create a Selection Container'|trans }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label" for="container_create_code">{{ 'Code'|trans({}, 'selection.bo.default') }}</label>
                            <input type="text" class="form-control" id="container_create_code" name="{{ container_create_form.vars.full_name }}[code]" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="container_create_title">{{ 'Title'|trans({}, 'selection.bo.default') }}</label>
                            <input type="text" class="form-control" id="container_create_title" name="{{ container_create_form.vars.full_name }}[title]" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="container_create_chapo">{{ 'Summary'|trans({}, 'selection.bo.default') }}</label>
                            <textarea class="form-control" id="container_create_chapo" name="{{ container_create_form.vars.full_name }}[chapo]"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
                        <button type="submit" class="btn btn-primary">{{ 'Save'|trans }}</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {# ------------------------ Create selection dialog ------------------------ #}
    <div class="modal fade" id="selection_creation_dialog" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" action="{{ path('selection.create.createSelection') }}">
                <input type="hidden" name="{{ selection_create_form.vars.full_name }}[success_url]" value="{{ path('selection.list') }}">
                <input type="hidden" name="{{ selection_create_form.vars.full_name }}[container_id]" value="{{ selected_container_id }}">
                <input type="hidden" name="{{ selection_create_form.vars.full_name }}[locale]" value="{{ edit_locale }}">
                <input type="hidden" name="{{ selection_create_form.vars.full_name }}[_token]" value="{{ selection_create_form._token.vars.value }}">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ 'Add a selection to this container'|trans({}, 'selection.bo.default') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label" for="selection_create_code">{{ 'Code'|trans({}, 'selection.bo.default') }}</label>
                            <input type="text" class="form-control" id="selection_create_code" name="{{ selection_create_form.vars.full_name }}[code]" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="selection_create_title">{{ 'Title'|trans({}, 'selection.bo.default') }}</label>
                            <input type="text" class="form-control" id="selection_create_title" name="{{ selection_create_form.vars.full_name }}[title]" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="selection_create_chapo">{{ 'Summary'|trans({}, 'selection.bo.default') }}</label>
                            <textarea class="form-control" id="selection_create_chapo" name="{{ selection_create_form.vars.full_name }}[chapo]"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
                        <button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, 'selection.bo.default') }}</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {# ------------------------ Delete container dialog ------------------------ #}
    <div class="modal fade" id="selection_container_delete_dialog" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" action="{{ path('admin.delete.selection.container') }}?_token={{ assignToken() }}">
                <input type="hidden" name="selection_container_id" id="selection_container_delete_id" value="">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ 'Delete selection container'|trans }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">{{ 'Do you really want to delete this container?'|trans }}</div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'No'|trans }}</button>
                        <button type="submit" class="btn btn-danger">{{ 'Yes'|trans }}</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {# ------------------------ Delete selection dialog ------------------------ #}
    <div class="modal fade" id="selection_delete_dialog" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" action="{{ path('admin.delete.selection') }}?_token={{ assignToken() }}">
                <input type="hidden" name="selection_id" id="selection_delete_id" value="">
                <input type="hidden" name="container_id" value="{{ selected_container_id }}">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ 'Delete selection'|trans({}, 'selection.bo.default') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">{{ 'Do you really want to delete this selection ?'|trans({}, 'selection.bo.default') }}</div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'No'|trans({}, 'selection.bo.default') }}</button>
                        <button type="submit" class="btn btn-danger">{{ 'Yes'|trans({}, 'selection.bo.default') }}</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endblock %}

{% block scripts_extra %}
    <script>
        document.querySelectorAll('.selection-delete').forEach(function (el) {
            el.addEventListener('click', function () {
                document.getElementById('selection_delete_id').value = this.dataset.id;
            });
        });
        document.querySelectorAll('.selection-container-delete').forEach(function (el) {
            el.addEventListener('click', function () {
                document.getElementById('selection_container_delete_id').value = this.dataset.id;
            });
        });
    </script>
{% endblock %}
