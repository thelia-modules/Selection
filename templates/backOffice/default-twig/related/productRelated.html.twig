{# Related products table rows, injected via fetch() into #product tbody #}
{% for row in rows %}
    <tr>
        <td>{{ row.id }}</td>
        <td>{{ row.title }}</td>
        <td class="text-center">
            <a href="{{ path('selection.productRelated.update-position', {'product_id': row.id, 'selection_id': selection_id, 'position': row.position}) }}"
               class="badge text-bg-secondary text-decoration-none" data-id="{{ row.id }}">{{ row.position }}</a>
        </td>
        <td class="text-center">
            {% if is_granted('DELETE', {resource: 'admin.selection', module: 'Selection'}) %}
                <a class="btn btn-secondary btn-sm value-delete"
                   title="{{ 'Delete this value'|trans({}, 'selection.bo.default') }}"
                   href="{{ path('admin.delete.selection.product', {'selectionID': selection_id, 'productID': row.id}) }}">
                    <i class="bi bi-trash"></i>
                </a>
            {% endif %}
        </td>
    </tr>
{% endfor %}
