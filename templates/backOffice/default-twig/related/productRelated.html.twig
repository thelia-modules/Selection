{# Related products table rows, injected via fetch() into #product tbody #}
{% for row in rows %}
    <tr>
        <td>{{ row.id }}</td>
        <td>{{ row.title }}</td>
        <td class="text-center">
            {# A POST with the token of the back office: the route refuses a state change without it. The product and the
               selection travel in the address, the new position is the field. #}
            <form method="post" action="{{ path('selection.productRelated.update-position', {'product_id': row.id, 'selection_id': selection_id}) }}" class="d-inline-flex">
                <input type="hidden" name="_token" value="{{ assignToken() }}">
                <input type="number" name="position" min="1" value="{{ row.position }}" class="form-control form-control-sm text-center" style="width: 5rem" data-id="{{ row.id }}" onchange="this.form.submit()">
            </form>
        </td>
        <td class="text-center">
            {% if is_granted('DELETE', {resource: 'admin.selection', module: 'Selection'}) %}
                <form method="post" class="d-inline" action="{{ path('admin.delete.selection.product', {'selectionID': selection_id, 'productID': row.id}) }}">
                    <input type="hidden" name="_token" value="{{ assignToken() }}">
                    <button type="submit" class="btn btn-secondary btn-sm value-delete"
                            title="{{ 'Delete this value'|trans({}, 'selection.bo.default') }}">
                        <i class="bi bi-trash"></i>
                    </button>
                </form>
            {% endif %}
        </td>
    </tr>
{% endfor %}
